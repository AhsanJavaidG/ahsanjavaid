<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cross-Team Support Platform — service design at LEKAB | Ahsan Javaid</title>
  <meta name="description" content="UX/UI case study: an internal cross-team support platform designed through service design, stakeholder ecosystem mapping, and co-design workshops." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="case-study.css" />
  <style>
    /* Page-specific: queue view + role badges */
    .queue { padding: 0.8rem 1rem; display: flex; flex-direction: column; gap: 0.5rem; overflow: hidden; }
    .q-item {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.55rem 0.7rem;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.7rem;
    }
    .q-badge {
      font-size: 0.55rem; font-weight: 700; letter-spacing: 0.05em;
      padding: 0.15rem 0.4rem; border-radius: 4px; color: #fff;
    }
    .q-badge.support { background: var(--accent); }
    .q-badge.ops { background: var(--warn); }
    .q-badge.eng { background: var(--ok); }
    .q-item b { display: block; font-family: "Fraunces", serif; font-weight: 500; font-size: 0.75rem; color: var(--ink); }
    .q-item span { color: var(--muted); font-size: 0.6rem; }
    .q-item em { font-style: normal; color: var(--muted-2); font-size: 0.6rem; font-weight: 500; }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="brand" href="index.html">Ahsan Javaid <span>· Case Study</span></a>
      <nav class="nav-side">
        <a href="#overview">Overview</a>
        <a href="#problem">Problem</a>
        <a href="#ecosystem">Ecosystem</a>
        <a href="#roles">Roles</a>
        <a href="#blueprint">Blueprint</a>
        <a href="#screens">Screens</a>
